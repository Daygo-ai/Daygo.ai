# Mailchimp Marketing API — used by app/api/subscribe/route.ts
# API key: Mailchimp account → Profile → Extras → API keys
MAILCHIMP_API_KEY=
# The suffix after the dash in your API key, e.g. abc123-us9 -> us9
MAILCHIMP_SERVER_PREFIX=us9
# Audience/list ID: Mailchimp → Audience → Settings → Audience name and defaults
MAILCHIMP_LIST_ID=2cdd9f479e
